{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "founders-cafe",
  "main": "src/index.js",
  "compatibility_date": "2026-05-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CAFE",
        "class_name": "CafeRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CafeRoom"]
    }
  ]
}
